rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Hulpfuncties ────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwn(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── Users ───────────────────────────────────
    // Medewerkers mogen eigen profiel lezen; admin alles
    match /users/{uid} {
      allow read: if isAuth();
      // Eigen profiel: alleen naam/wage niet aanpassen (beschermd via admin-only velden)
      allow update: if isOwn(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','wage']) || isAdmin();
      allow create, delete: if isAdmin();
    }

    // ── Shifts ──────────────────────────────────
    match /shifts/{shiftId} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
      // Medewerker mag alleen eigen bevestiging + tijden aanpassen
      allow update: if isAdmin() ||
        (isAuth() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['workerConfirmations', 'finalTimes']) &&
          // Mag alleen eigen uid-sleutel schrijven, niet die van anderen
          request.resource.data.workerConfirmations.keys().hasAll(resource.data.workerConfirmations.keys()) &&
          request.resource.data.get('finalTimes', {}).keys()
            .hasOnly(resource.data.get('finalTimes', {}).keys().concat([request.auth.uid]))
        );
    }

    // ── Beschikbaarheid ─────────────────────────
    match /availability/{docId} {
      allow read: if isAuth();
      // Aanmaken: alleen eigen uid, en uid-veld moet kloppen
      allow create: if isAuth() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasAll(['uid','date']) &&
        request.resource.data.keys().hasOnly(['uid','date','note','createdAt','timeFrom','timeTo']);
      // Verwijderen: eigen doc of admin
      allow delete: if isAuth() && resource.data.uid == request.auth.uid || isAdmin();
      // Update: alleen admin (admin kan beschikbaarheid corrigeren)
      allow update: if isAdmin();
    }

    // ── Notificaties / Inbox ────────────────────
    match /notifications/{docId} {
      // Lezen: je staat in 'to', of je bent admin (admin ziet alles)
      allow read: if isAuth() &&
        (resource.data.to.hasAny([request.auth.uid]) || isAdmin());
      // Aanmaken: ingelogd, 'from' moet eigen uid zijn
      allow create: if isAuth() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.keys().hasAll(['to','title','body','from','readBy','createdAt']) &&
        request.resource.data.readBy is list;
      // Update: alleen 'readBy' aanpassen (gelezen markeren)
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if isAdmin();
    }

    // ── Uitnodigingen ───────────────────────────
    match /invites/{inviteId} {
      // Publiek leesbaar zodat register.html werkt zonder login
      allow read: if true;
      allow create: if isAdmin();
      // Update: iedereen mag 'used' zetten (registratieflow)
      allow update: if true;
      allow delete: if isAdmin();
    }

    // ── Uitbetalingen ───────────────────────────
    match /payments/{docId} {
      allow read: if isAuth() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── Wachtwoord reset tokens ─────────────────
    match /pwresets/{docId} {
      // Publiek leesbaar zodat reset-pw.html werkt zonder login
      allow read: if true;
      allow create: if isAdmin();
      // Update: iedereen mag 'used:true' zetten na reset
      allow update: if true;
      allow delete: if isAdmin();
    }

    // ── App instellingen (toekomstig) ───────────
    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
