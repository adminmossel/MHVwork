rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()    { return request.auth != null; }
    function getRole()   { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin()   { return isAuth() && getRole() == 'admin'; }
    function isSoftware(){ return isAuth() && getRole() == 'software'; }
    function isStaff()   { return isAdmin() || isSoftware(); }

    match /users/{uid} {
      allow read: if isAuth();
      // Iedereen mag het EIGEN profiel-document aanmaken (na registratie via invite-link).
      // De Auth-account zelf kan alleen ontstaan via een geldige uitnodigingslink of de
      // hardcoded admin/dev-bypass, dus dit is veilig.
      allow create: if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow update: if isAdmin()
        || (isAuth() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','wage']));
      allow delete: if isStaff();
    }

    match /shifts/{id} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isAuth() && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['workerConfirmations','finalTimes','workers']));
    }

    match /availability/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isAuth()
        && (resource.data.to.hasAny([request.auth.uid]) || isStaff());
      allow create: if isAuth() && request.resource.data.from == request.auth.uid;
      allow update: if isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if isStaff();
    }

    match /chat/{id} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid','name','text','createdAt']);
      allow update: if isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','deletedBy','pinned','swapStatus','acceptedByName','interestedName']);
      allow delete: if isStaff();
    }

    match /swapRequests/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.requesterId == request.auth.uid;
      allow update: if isAdmin()
        || (isAuth() && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['interestedUid','interestedName']));
      allow delete: if isAdmin();
    }

    match /invites/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /payments/{id} {
      allow read: if isAuth()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /pwresets/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if true;
      allow delete: if isStaff();
    }
  }
}