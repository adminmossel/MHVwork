rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Users ───────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth();
      // Eigen profiel lezen/aanpassen (behalve role/wage)
      allow update: if (isAuth() && request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role','wage'])) || isAdmin();
      allow create: if isAdmin() ||
        // Seed-admin: mag alleen aanmaken als er nog geen admin bestaat
        // én het een admin-document is voor h.mhvwork@gmail.com
        (isAuth() && request.resource.data.email == 'h.mhvwork@gmail.com'
          && request.resource.data.role == 'admin'
          && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    // ── Shifts ──────────────────────────────────
    match /shifts/{shiftId} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isAuth() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['workerConfirmations','finalTimes']));
    }

    // ── Beschikbaarheid ─────────────────────────
    match /availability/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid || isAdmin();
      allow update: if isAdmin();
    }

    // ── Notificaties ────────────────────────────
    match /notifications/{docId} {
      allow read: if isAuth() &&
        (resource.data.to.hasAny([request.auth.uid]) || isAdmin());
      allow create: if isAuth() && request.resource.data.from == request.auth.uid;
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if isAdmin();
    }

    // ── Uitnodigingen ───────────────────────────
    match /invites/{inviteId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if true;
      allow delete: if isAdmin();
    }

    // ── Uitbetalingen ───────────────────────────
    match /payments/{docId} {
      allow read: if isAuth() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ── Wachtwoord reset tokens ─────────────────
    match /pwresets/{docId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if true;
      allow delete: if isAdmin();
    }

    // ── App instellingen ────────────────────────
    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
