rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()    { return request.auth != null; }
    function getRole()   { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin()   { return isAuth() && getRole() == 'admin'; }
    function isSoftware(){ return isAuth() && getRole() == 'software'; }
    function isStaff()   { return isAdmin() || isSoftware(); }
    // Door dev ingetrokken bevoegdheden van een beheerder-account (blokkeert specifieke acties
    // zonder het hele account te schorsen) — leeg/ontbrekend veld = geen restricties.
    function restr(key) {
      return isAdmin()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('restrictions',{}).get(key,false) == true;
    }

    match /users/{uid} {
      // Vroeger: elke ingelogde gebruiker mocht ALLE volledige profielen lezen (naam, e-mail,
      // loon, alles). Nu: het volledige document is alleen leesbaar voor jezelf en staff.
      // Voor wat anderen wél mogen zien (naam, rol, foto, geverifieerd-vinkje — nodig voor
      // chat/rooster/privéberichten) bestaat een aparte, beperkte 'publicProfiles'-collectie.
      // Iedereen mag het volledige profiel van een BEHEERDER/DEV lezen (nodig om ze te kunnen
      // mailen bij bv. een ruilverzoek of privébericht) — maar NIET dat van een collega-
      // medewerker. Dat sluit het oorspronkelijke lek (elke medewerker kon elke andere
      // medewerkers' e-mail + loon zien) terwijl bestaande functionaliteit blijft werken.
      allow read: if isAuth() && (request.auth.uid == uid || isStaff() || resource.data.role in ['admin','software']);
      // Zelf-registratie (na invite-link) blijft toegestaan, zoals voorheen. Geen hardcoded
      // email-bypass meer — rol komt uitsluitend uit het Firestore-document zelf.
      allow create: if isSoftware()
        || (isAdmin() && request.resource.data.role != 'software')
        || (isAuth() && request.auth.uid == uid);
      allow update: if (isAdmin() && !(request.resource.data.role=='software') && !(resource.data.role=='software' && request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified','restrictions']) && !restr('manageEmployees'))
        || isSoftware()
        || (isAuth() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','wage','verified']));
      allow delete: if isStaff() && !restr('manageEmployees');
    }

    // Publieke, bewust minimale profielgegevens: alleen wat nodig is om iemand herkenbaar te
    // tonen elders in de app — géén e-mail, loon of andere gevoelige velden. 'role'/'verified'
    // zijn na aanmaken alleen door staff aan te passen (voorkomt een zelf-toegekende nep-badge).
    match /publicProfiles/{uid} {
      allow read: if isAuth();
      allow create: if isAuth() && (request.auth.uid == uid || isStaff());
      allow update: if isStaff() || (isAuth() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoData','name']));
      allow delete: if isStaff();
    }

    match /shifts/{id} {
      allow read: if isAuth();
      allow create: if isAdmin() && !restr('editShift');
      allow delete: if isStaff() && !restr('deleteShift');
      allow update: if (isAdmin()
            && !(restr('payout') && request.resource.data.diff(resource.data).affectedKeys().hasAny(['paidFor']))
            && !(restr('approve') && request.resource.data.diff(resource.data).affectedKeys().hasAny(['workerConfirmations']))
            && !(restr('editShift') && request.resource.data.diff(resource.data).affectedKeys().hasAny(['startTime','endTime','workers','date','note'])))
        || (isAuth() && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['workerConfirmations','finalTimes','workers','reminderSent','reminder2Sent','confirmationLocked','dayBeforeSent','hourBeforeSent','unassignedReminderSent']));
    }

    match /availability/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isStaff();
      allow update: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note','date']));
    }

    match /notifications/{id} {
      allow read: if isAuth()
        && (resource.data.to.hasAny([request.auth.uid]) || isStaff());
      allow create: if isAuth() && request.resource.data.from == request.auth.uid;
      allow update: if isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if isStaff();
    }

    match /chat/{id} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid','name','text','createdAt']);
      allow update: if isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','deletedBy','pinned','swapStatus','acceptedByName','interestedName']);
      allow delete: if isStaff();
    }

    match /swapRequests/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.requesterId == request.auth.uid;
      allow update: if isAdmin()
        || (isAuth() && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['interestedUid','interestedName']));
      allow delete: if isStaff();
    }

    match /invites/{id} {
      // 'get' (één specifieke, unieke link) blijft nodig zonder inlog — dat IS de hele werking
      // van een uitnodigingslink. Maar 'list' (de hele collectie opvragen/doorzoeken) staat NIET
      // meer open: zonder deze scheiding kon letterlijk iedereen op internet, zonder in te loggen,
      // alle openstaande uitnodigingen (naam, e-mail, loon) in één keer uitlezen.
      allow get: if true;
      allow list: if isStaff();
      allow create: if isSoftware() || (isAdmin() && request.resource.data.role != 'software' && !restr('addEmployee'));
      // Alleen het 'used' veld mag gezet worden, en alleen zolang die nog niet gebruikt is
      // (voorkomt dat een link twee keer geclaimd kan worden, of dat iemand anders data wijzigt).
      allow update: if !resource.data.used
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used','usedAt','uid']);
      allow delete: if isStaff();
    }

    match /payments/{id} {
      allow read: if isAuth()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isStaff() && !restr('payout');
    }

    // Legacy collectie — niet meer gebruikt sinds wachtwoord-reset via Firebase Auth verloopt.
    // Blijft op slot te staan (alleen staff mag iets doen) zodat oude gecachte pagina's geen gat vormen.
    match /pwresets/{id} {
      allow read, write: if isStaff();
    }

    // Aankondigingen (homepage + dev "special" aankondigingen)
    match /announcements/{id} {
      allow read: if isAuth();
      allow create: if isStaff() && !restr('announcements');
      allow update: if isStaff();
      // Een beheerder mag geen 'speciale' (dev-only) aankondiging verwijderen — alleen dev zelf.
      allow delete: if isSoftware() || (isAdmin() && resource.data.special != true);
    }

    // Privéberichten (medewerker <-> beheerder/dev), 1 doc per thread
    match /dms/{threadId} {
      // 'resource == null' dekt het moment vóórdat het gesprek bestaat (de allereerste keer dat
      // je iemand een bericht stuurt) — zonder die check crasht de regel op resource.data van een
      // niet-bestaand document, en behandelt Firestore dat als een blokkade ("missing or
      // insufficient permissions"), zelfs voor een volkomen legitieme aanvraag.
      allow read: if isAuth() && (resource == null || resource.data.participants.hasAny([request.auth.uid]));
      allow create: if isAuth() && request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if isAuth() && resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages','updatedAt','readBy','lastText','lastFrom']);
      allow delete: if isStaff();
    }

    // Globale instellingen (bv. reminder-uren), alleen beheerder/dev mag schrijven
    match /settings/{id} {
      allow read: if isAuth();
      allow write: if isStaff();
    }

    // Alleen zichtbaar voor de dev-rol
    match /loginLogs/{id} {
      allow read: if isSoftware();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ip']);
      allow delete: if isSoftware();
    }
  }
}